3                  =Total Number of Conductors (N+1)
2.0                =Total Line Length (m)
1                  =Line Type (1=no gnd plane, 2=gnd plane)
1                  =Output Conductor for Terminal Voltages
1.0                =Incident Electric Field Amplitude (volts/m)
90.                =Polarization Angle of Electric Field (degrees)
90.                =Propagation Angle (Theta, degrees)
-90.               =Propagation Angle (Phi, degrees)
1  -1.27E-3 0.        =Conductor #, X, Y
2   1.27E-3 0.        =Conductor #, X, Y
1.51228E-1              =Reference Cond dc Resistance (ohms/m)
4.81374E5               =Reference Cond Resistance Break Frequency(Hz)
1   1.51228E-1          =I,dc Conductor(I) Resistance (ohms/m)
1   4.81374E5           =I,Conductor(I) Resistance Break Frequency(Hz)
2   1.51228E-1          =I,dc Conductor(I) Resistance (ohms/m)
2   4.81374E5           =I,Conductor(I) Resistance Break Frequency (Hz)
1        0.0       0.000          =I,VSREAL(I),VSIMAG(I)
2        0.0       0.000          =I,VSREAL(I),VSIMAG(I)
1   1    500.      0.000          =I,J,ZSREAL(I,J),ZSIMAG(I,J)
1   2    000.      0.000          =I,J,ZSREAL(I,J),ZSIMAG(I,J)
2   2    500.      0.000          =I,J,ZSREAL(I,J),ZSIMAG(I,J)
1        0.0       0.000          =I,VLREAL(I),VLIMAG(I)
2        0.0       0.000          =I,VLREAL(I),VLIMAG(I)
1   1    500.      0.000          =I,J,ZLREAL(I,J),ZLIMAG(I,J)
1   2    000.      0.000          =I,J,ZLREAL(I,J),ZLIMAG(I,J)
2   2    500.      0.000          =I,J,ZLREAL(I,J),ZLIMAG(I,J)
