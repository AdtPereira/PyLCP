3                       =Total Number of Conductors (N+1)
2.0                     =Total Line Length (m)
1                       =Line Type(1=no gnd plane, 2=gnd plane)
90.                     =THETAE
90.                     =THETAP
-90.                    =PHIP
1    -1.27E-3     0.0      =I,X(I),Y(I)
2     1.27E-3     0.0      =I,X(I),Y(I)
20                           =NDZ
1000                         =NDT  Must Have NDT>>NDZ*FINAL*V0/LEN
100.E-9                      =Final Solution Time
1                            =Print Solution Time Step Index
1                            =Output Conductor for Terminal Voltages
1   1   500.0     500.0           =I,J,RS(I,J),RL(I,J)     (ohms)
1   2     0.0       0.0           =I,J,RS(I,J),RL(I,J)     (ohms)
2   2   500.0     500.0           =I,J,RS(I,J),RL(I,J)     (ohms)
