{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug: Arquivo Atual como Módulo",
            "type": "debugpy",
            "request": "launch",
            "console": "integratedTerminal",
            // Executa o nosso script runner
            "program": "${workspaceFolder}/debug_runner.py",
            // Passa o caminho do arquivo atualmente aberto como um argumento para o script
            "args": ["${file}"]
        }
    ]
}